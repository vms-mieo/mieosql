{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MieoSQL",
  "version": "0.1.1",
  "identifier": "dev.mieosql.desktop",
  "build": {
    "frontendDist": "./frontend/dist",
    "beforeBuildCommand": "npm install --no-audit --no-fund && npm run build"
  },
  "app": {
    "withGlobalTauri": false,
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Multi-engine database client",
    "longDescription": "MieoSQL is a multi-engine database client (MySQL, MariaDB, PostgreSQL, SQLite) with a Rust core and TypeScript UI."
  }
}
