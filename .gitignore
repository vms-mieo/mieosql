# ===========================================================================
# MieoSQL — những gì KHÔNG đẩy lên git
# ===========================================================================

# --- Rust / Cargo ----------------------------------------------------------
/target
**/target/
**/*.rs.bk

# --- Node / frontend -------------------------------------------------------
node_modules/
dist/
.vite/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Tauri -----------------------------------------------------------------
# Schema/generated files (sinh bởi tauri-build)
apps/mieosql-desktop/gen/
# Signing keys — tuyệt đối không commit
*.p12
*.pfx
*.pem
*.key

# --- Local data / demo databases ------------------------------------------
*.mieosql
.mieosql/
*.sqlite
*.sqlite3
*.db
*.db3
*.duckdb

# --- Scratch / generated, never commit --------------------------------------
# Design mockups, screenshots, QA reports (local reference only).
design/
images/
reports/
# Local Arch-package staging (CI builds it fresh under dist-arch/).
dist-arch/
# Stray dir: tauri runs build hooks with cwd already inside frontend/, so a
# `npm --prefix frontend ...` hook once created this nested stub. The hook is
# fixed (bare `npm ...`), this entry guards against recurrence.
apps/mieosql-desktop/frontend/frontend/

# --- Secrets / env ---------------------------------------------------------
.env
.env.*
!.env.example

# --- Logs / temp -----------------------------------------------------------
*.log
tmp/
.tmp/

# --- IDE / editors ---------------------------------------------------------
.vscode/*
!.vscode/extensions.json
.idea/
*.iml
*.swp
*.swo
*~

# --- OS --------------------------------------------------------------------
.DS_Store
._*
Thumbs.db
Desktop.ini
